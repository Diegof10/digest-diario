# Obligatorio en Vercel Cron (Authorization: Bearer …)
CRON_SECRET=cambia-esto

# Destinatario default del contador
MAIL_TO=contador@estudio.com

# Resend (si falta, el check solo loguea el mail en consola)
RESEND_API_KEY=
MAIL_FROM=Alerta SISA <onboarding@resend.dev>

# 1 = diff sin persistir ni mandar
DRY_RUN=0
